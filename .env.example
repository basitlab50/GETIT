# ==========================================
# GETIT Platform - Supabase Credentials
# ==========================================

# 1. Web (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Seeder & Backend Scripts
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-or-service-role-key

# ==========================================
# GETIT REAL SMS & EMAIL GATEWAYS
# ==========================================
# SMS Provider: 'termii' (Nigeria #1) | 'twilio' | 'simulation'
VITE_SMS_PROVIDER=termii
VITE_TERMII_API_KEY=
VITE_TERMII_SENDER_ID=GETIT
VITE_TERMII_CHANNEL=generic

# Email Provider: 'resend' (Modern) | 'sendgrid' | 'simulation'
VITE_EMAIL_PROVIDER=resend
VITE_RESEND_API_KEY=
VITE_RESEND_FROM="GETIT Security <onboarding@resend.dev>"
